{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and identity settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string", "description": "The unique @handle selected by the user" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "fcmToken": { "type": "string" },
        "online": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "notificationSettings": {
          "type": "object",
          "properties": {
            "soundEnabled": { "type": "boolean" },
            "pushEnabled": { "type": "boolean" }
          }
        },
        "accountType": { "type": "string", "enum": ["personal", "business"] },
        "storeName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "accountType", "email"]
    },
    "Chat": {
      "title": "Chat Session",
      "description": "Information about a chat between users or a group.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "isGroup": { "type": "boolean" },
        "groupName": { "type": "string" },
        "groupAvatar": { "type": "string" },
        "createdBy": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "video"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "read"] },
        "reactions": { "type": "object", "description": "Map of userId to emoji reaction" }
      },
      "required": ["senderId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document and identity configuration."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Root collection for chat sessions."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a specific chat session."
    }
  }
}
