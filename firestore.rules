rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'username', 'accountType', 'createdAt', 'updatedAt']) &&
               data.keys().size() >= 5 &&
               data.uid == request.auth.uid &&
               data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
               data.accountType in ['personal', 'business'] &&
               data.createdAt == request.time &&
               data.updatedAt == request.time;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isSignedIn() && isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['photoURL', 'displayName', 'storeName', 'updatedAt', 'fcmToken', 'online', 'lastSeen', 'notificationSettings']) &&
        (!incoming().diff(existing()).affectedKeys().hasAny(['updatedAt']) || incoming().updatedAt == request.time) &&
        (!incoming().diff(existing()).affectedKeys().hasAny(['lastSeen']) || incoming().lastSeen == request.time) &&
        incoming().username == existing().username &&
        incoming().uid == existing().uid &&
        incoming().accountType == existing().accountType
      );
    }

    // Chat Rules
    match /chats/{chatId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      
      allow create: if isSignedIn() && 
                    request.auth.uid in incoming().participants &&
                    (!incoming().isGroup || (incoming().groupName is string && incoming().groupName.size() >= 3));
      
      allow update: if isSignedIn() && request.auth.uid in existing().participants && (
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt', 'groupName', 'groupAvatar'])
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      incoming().senderId == request.auth.uid &&
                      incoming().createdAt == request.time;
        allow update: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'status']);
      }
    }
  }
}
