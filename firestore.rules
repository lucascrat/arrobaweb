rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      let email = request.auth.token.get('email', '');
      return isSignedIn() && (email == "lrlucasrafael11@gmail.com" || email == "lucasrafaellrl11@gmail.com"); 
    }
    function isVerified() { return isSignedIn() && request.auth.token.get('email_verified', false) == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isParticipant(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId));
      return isSignedIn() && chat != null && request.auth.uid in chat.data.participants;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    // Chat Rules
    match /chats/{chatId} {
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && request.auth.uid in existing().participants;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId) && (incoming().senderId == request.auth.uid);
        allow update: if isParticipant(chatId) && incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'status']);
      }
    }

    // Store Rules
    match /stores/{ownerId} {
      allow read: if true;
      allow write: if isOwner(ownerId);

      match /products/{productId} {
        allow read: if true;
        allow write: if isOwner(ownerId);
      }
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isOwner(ownerId);
      }
      match /appointments/{appId} {
        allow read: if isOwner(ownerId) || (isSignedIn() && (resource != null && resource.data.userId == request.auth.uid));
        allow create: if isSignedIn();
        allow update, delete: if isOwner(ownerId);
      }
    }

    // Template Rules
    match /storeTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Call Rules
    match /calls/{chatId} {
      allow read, write: if isParticipant(chatId);
      
      match /callerCandidates/{candidateId} {
        allow read, write: if isParticipant(chatId);
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if isParticipant(chatId);
      }
    }
  }
}
